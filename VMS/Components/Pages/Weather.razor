@page "/weather"
@using MudBlazor



@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<PageTitle>Weather Forecast</PageTitle>

<h1>Weather Forecast</h1>

<MudTable Items="_data" Dense="true" Hover="true" Elevation="1">
    <HeaderContent>
        <MudTh>Date</MudTh>
        <MudTh>Temp (°C)</MudTh>
        <MudTh>Summary</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Date.ToString("yyyy-MM-dd")</MudTd>
        <MudTd>@context.TemperatureC</MudTd>
        <MudTd>@context.Summary</MudTd>
    </RowTemplate>
</MudTable>

@code {
    private Forecast[] _data = new[]
    {
        new Forecast { Date = new DateOnly(2025,10,01), TemperatureC = 22, Summary = "Mild" },
        new Forecast { Date = new DateOnly(2025,10,02), TemperatureC = 18, Summary = "Cool" },
        new Forecast { Date = new DateOnly(2025,10,03), TemperatureC = 25, Summary = "Warm" },
        new Forecast { Date = new DateOnly(2025,10,04), TemperatureC = 27, Summary = "Sunny" },
        new Forecast { Date = new DateOnly(2025,10,05), TemperatureC = 16, Summary = "Breezy" }
    };

    public class Forecast
    {
        public DateOnly Date { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
    }
}
